[Desktop Entry]
Type=Application
Name=Klimt
GenericName=Image Editor
Comment=Retouch, mask, adjust and composite raster images
Exec=@BINDIR@/klimt %F
MimeType=image/png;image/jpeg;image/tiff;
Icon=io.github.scott8420.Klimt
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=image;photo;raster;layers;masks;retouch;editor;
StartupNotify=true
StartupWMClass=io.github.scott8420.Klimt
