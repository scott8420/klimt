<?xml version="1.0" encoding="UTF-8"?>
<!-- Cairn resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("klimt-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground -- no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/scott8420/Klimt/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/scott8420/Klimt/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="klimt-logo-symbolic.svg">icons/scalable/apps/klimt-logo-symbolic.svg</file>
    <!-- s005: the tool rail's icons -- made from scripts/icons-src/ by
         scripts/make_icons.sh (strokes -> filled outlines, so GTK can recolour) -->
    <file preprocess="xml-stripblanks" alias="klimt-layer-mask-symbolic.svg">icons/scalable/apps/klimt-layer-mask-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-adjustment-symbolic.svg">icons/scalable/apps/klimt-adjustment-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-filter-layer-symbolic.svg">icons/scalable/apps/klimt-filter-layer-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-subject-symbolic.svg">icons/scalable/apps/klimt-subject-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-brush-symbolic.svg">icons/scalable/apps/klimt-tool-brush-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-smudge-symbolic.svg">icons/scalable/apps/klimt-tool-smudge-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-clone-symbolic.svg">icons/scalable/apps/klimt-tool-clone-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-crop-symbolic.svg">icons/scalable/apps/klimt-tool-crop-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-eraser-symbolic.svg">icons/scalable/apps/klimt-tool-eraser-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-eyedropper-symbolic.svg">icons/scalable/apps/klimt-tool-eyedropper-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-gradient-symbolic.svg">icons/scalable/apps/klimt-tool-gradient-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-hand-symbolic.svg">icons/scalable/apps/klimt-tool-hand-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-heal-symbolic.svg">icons/scalable/apps/klimt-tool-heal-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-move-symbolic.svg">icons/scalable/apps/klimt-tool-move-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-select-symbolic.svg">icons/scalable/apps/klimt-tool-select-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-refine-symbolic.svg">icons/scalable/apps/klimt-tool-refine-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-pen-symbolic.svg">icons/scalable/apps/klimt-tool-pen-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-text-symbolic.svg">icons/scalable/apps/klimt-tool-text-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="klimt-tool-zoom-symbolic.svg">icons/scalable/apps/klimt-tool-zoom-symbolic.svg</file>
  </gresource>
  <!-- s027: the About window's painting panel -- Klimt's The Dancer, made with the app
       icons by scripts/make_app_icon.py. Not an icon, so its own prefix. -->
  <gresource prefix="/io/github/scott8420/Klimt/images">
    <file alias="klimt-about-panel.jpg">images/klimt-about-panel.jpg</file>
  </gresource>
  <!-- s027: the About window's License tab reads the project's own LICENSE,
       so the two can't drift. -->
  <gresource prefix="/io/github/scott8420/Klimt/text">
    <file alias="LICENSE">../LICENSE</file>
  </gresource>
</gresources>
